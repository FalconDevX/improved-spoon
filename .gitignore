# GD-Sync API keys. Never commit these.
addons/GD-Sync/keys.cfg

# Godot: cache importu (odtwarza się sam)
.godot/*
# wyjątek: rejestr nazw klas (class_name) — bez niego autoload GD-Sync nie wczyta się
# na świeżo sklonowanym projekcie („Brak wtyczki GD-Sync”)
!.godot/global_script_class_cache.cfg
*.tmp

# zrzuty i skrypty testowe
_tmp/

# silnik Godota (lezy obok start.bat, za duzy na GitHuba)
*.exe

# wyeksportowana gra (zawiera klucze API)
build/
